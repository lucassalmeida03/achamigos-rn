{
  "expo": {
    "name": "achamigos-rn",
    "slug": "achamigos-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "achamigosrn",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.achamigos.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logocerto.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF7A00",
          "image": "./assets/images/logocerto.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ac573929-2649-4219-b2a8-a58c42a5c98b"
      }
    }
  }
}
