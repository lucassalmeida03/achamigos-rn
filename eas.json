  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://utils-consider-vinyl-protocols.trycloudflare.com"
      }
    },
    "production": {
